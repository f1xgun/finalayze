# ── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency files and package metadata (cache layer)
COPY pyproject.toml uv.lock README.md ./
COPY src/finalayze/__init__.py src/finalayze/__init__.py

# Install production dependencies only.
# BuildKit cache mount keeps uv's wheel cache between builds — a dep change
# invalidates the layer but uv finds the previously-downloaded wheels
# (torch ~140MB, nvidia-nccl ~307MB, etc.) in the shared cache dir so the
# next rebuild skips the slow HTTPS round-trip. UV_LINK_MODE=copy silences
# the "different filesystem" warning when linking from /root/.cache/uv
# to /app/.venv.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    UV_LINK_MODE=copy UV_HTTP_TIMEOUT=300 uv sync --frozen --no-dev

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

# Create non-root user
RUN groupadd -g 1000 finalayze && \
    useradd -u 1000 -g finalayze -m -s /bin/bash finalayze

WORKDIR /app

# Install uv (needed for `uv run` in entrypoint)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy venv from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/pyproject.toml /app/uv.lock /app/
COPY README.md /app/README.md

# Copy application code
COPY src/ src/
COPY config/ config/
COPY alembic/ alembic/
COPY certs/ certs/

# Copy entrypoints
COPY docker/entrypoint.sh /app/entrypoint.sh
COPY docker/streamlit-entrypoint.sh /app/streamlit-entrypoint.sh
RUN chmod +x /app/entrypoint.sh /app/streamlit-entrypoint.sh

# Set ownership
RUN chown -R finalayze:finalayze /app

EXPOSE 8000

USER finalayze

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health')"

ENTRYPOINT ["/app/entrypoint.sh"]
